# Where the Next.js server proxies /api/* (FastAPI). In Docker: http://backend:8000
BACKEND_URL=http://127.0.0.1:8000
# Speech recognition / synthesis language: en-US (English) or ar-SA (Arabic)
NEXT_PUBLIC_SPEECH_LANG=en-US
# Brand the app speaks for — keep in sync with backend INSURER_NAME / INSURER_SHORT
NEXT_PUBLIC_INSURER_NAME=Al Rajhi Takaful
NEXT_PUBLIC_INSURER_SHORT=Al Rajhi Takaful
# If the chat says the backend isn't reachable although uvicorn is running, skip the proxy and call FastAPI directly:
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# Assistant name in the UI
NEXT_PUBLIC_ASSISTANT_NAME=Amaan
NEXT_PUBLIC_ASSISTANT_NAME_AR=أمان
