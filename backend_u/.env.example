# --- Gemini ------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Leave empty to run in OFFLINE DEMO MODE (rule-based agent + keyword RAG).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_TEMPERATURE=0.3

# --- Brand (the app speaks as this insurer)
INSURER_NAME=Al Rajhi Takaful
INSURER_SHORT=Al Rajhi Takaful

# --- Storage -----------------------------------------------------------
DATA_DIR=./data

# --- App ---------------------------------------------------------------
DEFAULT_CUSTOMER_ID=CUST-1001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Assistant name shown and spoken by the bot
ASSISTANT_NAME=Amaan
ASSISTANT_NAME_AR=أمان
# Enterprise systems shown in the "What's happening" panel (simulated round trips) — rename to match the landscape
SYSTEM_CRM=ESKA
SYSTEM_RATING=Neutrinos
SYSTEM_CORE=iFoundry
SYSTEM_PAYMENTS=Payment Engine

# ---- Gemini on Vertex AI (your Google Cloud project) — used instead of the API key when VERTEX_PROJECT is set
LLM_PROVIDER=vertex
VERTEX_PROJECT=art-uat-genai-h-claims-0
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash-lite
# Flex PayGo (cheaper, best-effort; replies can be slower). false = standard pay-as-you-go
VERTEX_FLEX=true
# gcloud = uses `gcloud auth print-access-token` (run `gcloud auth login` once); adc = application default credentials
VERTEX_AUTH=gcloud
# Seconds to wait for Vertex before the chat answers with the offline agent instead
VERTEX_TIMEOUT=120

# ---- Voice (uses the same Google Cloud project + gcloud login as Vertex AI)
# Speaking: Google Chirp 3 HD voices first, then Microsoft neural voices, then the browser's voice
TTS_PROVIDER=google,edge
TTS_GOOGLE_VOICE_EN=en-US-Chirp3-HD-Aoede
TTS_GOOGLE_VOICE_AR=ar-XA-Chirp3-HD-Aoede
TTS_GOOGLE_RATE=1.05
# Listening: Google Cloud Speech-to-Text (Chirp 3 in EU, then "short" in global); browser recognition if unavailable
STT_PROVIDER=google
STT_MODELS=chirp_3@eu,short@global
STT_LANG_AR=ar-SA
